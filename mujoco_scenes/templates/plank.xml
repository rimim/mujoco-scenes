<mujoco model="{name} seesaw plank scene">
  <include file="{path}"/>

  <default>
    <geom friction="1.5 0.01 0.0006"/>
  </default>

  <visual>
    <headlight diffuse="1 1 1" ambient=".55 .55 .55" specular=".15 .15 .15"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <statistic center="0 0 .3" extent="0.6"/>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.55 0.70 0.90"
             rgb2="0.72 0.72 0.72"
             width="512" height="3072"/>

    <material name="floor_mat"   rgba="0.62 0.60 0.58 1" reflectance="0.02"/>
    <material name="plywood_mat" rgba="0.82 0.72 0.55 1" reflectance="0.05"/>
    <material name="log_mat"     rgba="0.55 0.38 0.24 1" reflectance="0.03"/>
  </asset>

<worldbody>
  <!-- Ground at z = 0 -->
  <geom name="floor"
        type="plane"
        size="5 5 0.1"
        pos="0 0 0"
        material="floor_mat"
        conaffinity="1"
        contype="1"/>

  <!-- Visual-only log on ground.
       radius = 0.05, length = 0.28.
       Center z = radius, so bottom touches floor at z = 0. -->
  <body name="fulcrum_log" pos="1 0 0.05">
    <geom name="fulcrum_log"
          type="cylinder"
          size="0.05"
          fromto="0 -0.14 0   0 0.14 0"
          material="log_mat"
          contype="0"
          conaffinity="0"/>
  </body>

  <!-- Plank pivot is at the top of the log: z = 0.10.
       The plank geom is shifted upward by its half-thickness. -->
<body name="plank" pos="1 0 0.10" euler="0 -8 0">
  <inertial pos="0 0 0"
            mass="0.35"
            diaginertia="0.0010 0.0089 0.0098"/>

  <joint name="plank_pitch"
         type="hinge"
         axis="0 1 0"
         limited="true"
         range="-18 18"
         damping="0.05"
         frictionloss="0.001"
         armature="0.0005"
         stiffness="0"
         springref="0"/>

  <geom name="plank_geom"
        type="box"
        pos="0 0 0.003175"
        size="0.575 0.59 0.003175"
        mass="0.35"
        material="plywood_mat"
        friction="1.6 0.06 0.01"
        contype="1"
        conaffinity="0"/>
</body>
</worldbody>
</mujoco>
