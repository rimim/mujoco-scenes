<mujoco model="{name} biped_arena_hfield_v2">
  <!-- include robot model -->
  <include file="{path}"/>

  <compiler angle="degree" coordinate="local" 
            texturedir="." meshdir="."/>

  <default>
    <geom condim="4" friction="1.0 0.005 0.0001" solref="0.01 1" solimp="0.9 0.95 0.001 0.5 2"/>
  </default>

  <asset>
    <hfield name="arena" file="assets/biped_arena_heightfield_v2.png" size="15.0 6.0 0.25 0.6"/>

    <texture name="tex_ground" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.20 0.25 0.20" rgb2="0.24 0.30 0.24"/>
    <material name="mat_ground" texture="tex_ground" texrepeat="10 4" reflectance="0.02" rgba="0.7 0.8 0.7 1"/>
  </asset>

  <worldbody>
    <geom name="terrain" type="hfield" hfield="arena" pos="0 0 0" material="mat_ground"/>

    <!-- Catch plane a hair below the minimum heightfield height -->
    <geom name="catch" type="plane" pos="0 0 -0.01" size="80 80 0.1" rgba="0.15 0.18 0.15 1"/>

    <light name="sun" pos="0 0 5.0" dir="0 0 -1" directional="true" diffuse="1 1 1" specular="0.2 0.2 0.2"/>

    <camera name="overview" pos="-18 -18 7.0" euler="25 0 45"/>
    <camera name="side" pos="0 -18 2.2" euler="10 0 0"/>

    <site name="spawn" pos="-13 0 0.02" size="0.03" rgba="0 1 0 1"/>
    <site name="goal"  pos=" 13 0 0.02" size="0.03" rgba="1 0 0 1"/>
  </worldbody>
</mujoco>
