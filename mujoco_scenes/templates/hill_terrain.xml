<mujoco model="{name} crater potholes">
  <include file="{path}" />
  <asset>
    <texture name="check" type="2d" builtin="checker"
             width="512" height="512" rgb1="0.9 0.9 0.9" rgb2="0.6 0.6 0.6"/>
    <material name="ground" texture="check" texrepeat="12 12"
              reflectance="0.1" shininess="0.05"/>

    <!-- Make size[2] comfortably above your max hill height -->
    <hfield name="terrain" file="hill_hfield.png"
            size="10 10 0.35 0.01" />
  </asset>

  <worldbody>
    <light name="sun" directional="true" pos="0 0 5" dir="0.3 0.2 -1"
           diffuse="1 1 1" specular="0.2 0.2 0.2"/>

    <geom name="floor" type="hfield" hfield="terrain" material="ground"
          pos="0 0 -0.1" contype="1" conaffinity="1"
          friction="1 0.005 0.0001"/>
  </worldbody>
</mujoco>
